{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@agency/config nextjs",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "noEmit": true,
    "declaration": false,
    "plugins": [{ "name": "next" }],
    "module": "esnext",
    "target": "ES2017"
  }
}
